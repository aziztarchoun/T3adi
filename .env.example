# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Database ---
# Matches docker-compose.yml by default; change if you run Postgres elsewhere.
DATABASE_URL=postgresql://roadsafety:roadsafety_dev@localhost:5432/roadsafety

# --- Backend server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGIN=http://localhost:5173

# --- Sessions / auth ---
# Random long string used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-in-production

# --- Google OAuth (optional accounts) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Frontend (Vite reads these at build time, must be prefixed VITE_) ---
# Leave blank in local development to use the Vite /api proxy.
VITE_API_BASE_URL=
# Map tile provider key (MapTiler free tier: https://www.maptiler.com/)
VITE_MAPTILER_KEY=

# --- Rate limiting ---
# Max report/confirmation writes per device/IP per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_WRITES=20
